{
  "name": "web-game-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n api,game,web -c blue,magenta,green \"pnpm dev:api\" \"pnpm dev:game\" \"pnpm dev:web\"",
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/index.ts",
    "dev:game": "node --env-file=.env --import tsx --watch apps/game-server/src/index.ts",
    "dev:web": "pnpm --dir apps/web exec vite --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env ./node_modules/@playwright/test/cli.js test",
    "build": "pnpm --dir apps/web build",
    "lint": "eslint .",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.0",
    "zod": "^3.24.0"
  }
}
